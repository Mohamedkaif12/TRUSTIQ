# ─────────────────────────────────────────────────────────────────────────────
# TRUSTIQ — TRUST WAR  |  Phase 4 Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# SECURITY NOTICE:
#   • This file contains secrets — NEVER commit it to version control.
#   • It is already listed in .gitignore.
#   • Copy this file to .env and fill in your actual values.
#
# ── AI Provider ────────────────────────────────────────────────────────────
#
# OPENROUTER_API_KEY
#   Your OpenRouter API key from https://openrouter.ai/keys
#   Without this key the AI agent falls back to deterministic analysis.
#
OPENROUTER_API_KEY=

#
# AI_MODEL
#   The model identifier to use via OpenRouter.
#   Recommended free / low-cost options:
#     openai/gpt-4o-mini            (fast, capable)
#     anthropic/claude-3-haiku      (balanced)
#     google/gemini-flash-1.5       (fast, free tier)
#     meta-llama/llama-3.1-8b-instruct:free  (free)
#
AI_MODEL=openai/gpt-4o-mini

#
# OPENROUTER_BASE_URL
#   Leave as default unless using a different OpenAI-compatible endpoint.
#
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

#
# AI_TIMEOUT_SECONDS
#   How long to wait for an AI response before falling back.
#   Default: 20
#
AI_TIMEOUT_SECONDS=20
